{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true, 
	},
	"exclude": [
        "./github"
        ],
      "keybindings": [
            {
                "command": "i_c_fn_head.onKeyPress",
                "key": "up",      // Change this to your preferred key combo
                "when": "editorTextFocus" // The command will trigger when the editor is focused
            }
        ]
}
